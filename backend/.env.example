NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/udyam_digital
CORS_ORIGIN=http://localhost:3000
JWT_ACCESS_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=10
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
# COOKIE_DOMAIN=
GEMINI_API_KEY=api-key-goes-here
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
ADMIN_SECRET=replace-with-a-long-random-admin-secret

# Twilio WhatsApp (order confirmations + advisor chatbot)
# Copy Account SID and Auth Token from https://console.twilio.com.
# For local testing enable the Twilio WhatsApp Sandbox (Messaging > Try it out)
# and send "join <your-code>" from your phone to the sandbox number first.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
# WhatsApp sender in E.164 format. The "whatsapp:" prefix is optional.
TWILIO_WHATSAPP_FROM=+14155238886
# Alternatively use a Messaging Service instead of TWILIO_WHATSAPP_FROM.
# TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_ENABLED=true
# text = free-form messages (sandbox / open 24h customer-service window).
# template = business-initiated order confirmations via Twilio Content API.
WHATSAPP_MESSAGE_TYPE=text
# Required when WHATSAPP_MESSAGE_TYPE=template. Create an approved WhatsApp
# content template in Twilio and paste its HX... Content SID here.
# Variables expected by the order confirmation template:
#   {{1}} customer name, {{2}} order reference, {{3}} monthly total,
#   {{4}} estimated activation date.
# TWILIO_CONTENT_SID=HXxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Exact public URL Twilio calls. Set this when running behind a proxy so
# request signatures validate correctly; otherwise the URL is inferred.
# TWILIO_WEBHOOK_URL=https://example.com/api/whatsapp/webhook
WHATSAPP_DEFAULT_COUNTRY_CODE=91
TWILIO_TIMEOUT_MS=10000