{
  "name": "express-server",
  "version": "1.0.0",
  "description": "An ExpressJS server",
  "type": "module",
  "scripts": {
    "dev": "npx tsx --watch --env-file .env src/index.ts",
    "start": "npx tsc && node --env-file .env dist/index.js",
    "db:migrate": "npx tsx --env-file .env src/db/migrate.ts",
    "db:seed:mock-registries": "npx tsx --env-file .env src/db/seed-mock-registries.ts",
    "db:seed": "npx tsx --env-file .env src/db/seed.ts",
    "whatsapp:test": "npx tsx --env-file .env src/scripts/test-whatsapp.ts",
    "typecheck": "tsc --noEmit",
    "setup": "rm -rf .git && git init && git add . && git commit -m 'init'",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "author": "rahul-p19",
  "license": "ISC",
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pdf-to-img": "^7.0.2",
    "pg": "^8.23.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
